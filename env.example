# Copy to .env and replace the password BEFORE first start.
# Used only to initialize /data/security.json; afterwards change it in the Security panel.
DASHBOARD_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_PASSWORD

# Bind to all interfaces, or set 127.0.0.1 when using a local reverse proxy.
DASHBOARD_BIND_IP=0.0.0.0
DASHBOARD_PORT=8080
TZ=Europe/Stockholm

# Login sessions are in memory and end on container restart.
SESSION_TIMEOUT_MINUTES=30
# true only when the dashboard is accessed over HTTPS (e.g. reverse proxy).
COOKIE_SECURE=false

# Status checker settings (seconds).
STATUS_INTERVAL=60
STATUS_TIMEOUT=5
# Only set true for endpoints with intentionally untrusted/self-signed certificates.
STATUS_INSECURE_TLS=false
